#maze {
  display: grid;
  grid-template-columns: repeat(5, 50px);
  grid-template-rows: repeat(5, 50px);
  gap: 5px;
  margin-top: 20px;
}

.cell {
  width: 50px;
  height: 50px;
  background: #eee;
}

.wall {
  background: #333;
}

.player {
  background: #3498db;
}

.goal {
  background: #2ecc71;
}

#message {
  margin-top: 15px;
  font-size: 1.2rem;
  font-weight: bold;
}
